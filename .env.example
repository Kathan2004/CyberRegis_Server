# Copy to .env and fill in. Never commit .env.

# --- Server -----------------------------------------------------------
FLASK_ENV=development            # production refuses to start without API_TOKEN
FLASK_HOST=127.0.0.1             # non-loopback requires API_TOKEN
FLASK_PORT=5000
FLASK_DEBUG=false
# Shared secret clients send as "Authorization: Bearer <token>" or "X-API-Key".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SSL_VERIFY=true
# Allow scanning RFC1918/loopback targets. Only for an isolated lab.
ALLOW_PRIVATE_TARGETS=false
LOG_LEVEL=INFO

# --- Threat intel providers (all optional) -----------------------------
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SAFE_BROWSING_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
MALWAREBAZAAR_API_KEY=
GEMINI_API_KEY=

# --- Telegram alerts + bot --------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to receive alerts and issue bot commands.
TELEGRAM_CHAT_ID=
